# Default example values.
# For daily development, prefer a hosted staging project copied into app/.env.local.staging.
# For isolated schema work, use app/.env.local.local-supabase.

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Production Supabase (only needed for scripts that sync staging → prod,
# e.g. scripts/sync-curator-notes-to-prod.ts). Leave unset for normal dev.
PROD_SUPABASE_URL=https://your-production-project.supabase.co
PROD_SUPABASE_SERVICE_KEY=your-prod-service-role-key

# AWS Configuration
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=digital-grimoire-library

# Claude API (for AI reasoning)
CLAUDE_API_KEY=your-claude-api-key

# OpenRouter API (for text, JSON, vision metadata, and Parallax generation)
OPENROUTER_API_KEY=your-openrouter-api-key
# Live free model list: https://openrouter.ai/models?max_price=0
# Alternates: openai/gpt-oss-120b:free, qwen/qwen3-next-80b-a3b-instruct:free, google/gemma-4-31b-it:free
OPENROUTER_MODEL=deepseek/deepseek-v4-flash:free
OPENROUTER_METADATA_MODEL=deepseek/deepseek-v4-flash:free
OPENROUTER_APP_TITLE=Prismarium

# OpenAI API (still used for embeddings and Whisper transcription)
OPENAI_API_KEY=your-openai-api-key

# Mistral API (used for PDF OCR — ~$1 per 1000 pages, handles scanned PDFs)
# Get a key at https://console.mistral.ai/
MISTRAL_API_KEY=your-mistral-api-key
# Optional: override the OCR model (default: mistral-ocr-latest)
# MISTRAL_OCR_MODEL=mistral-ocr-latest

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# L0-04 server-only containment. Both values intentionally default to empty.
# Enable actions one at a time only after their later billing/metering packet is
# verified. Checkout also requires an exact Price ID in its separate allowlist.
PRISMARIUM_ENABLED_COMMERCIAL_ACTIONS=
PRISMARIUM_CHECKOUT_ALLOWED_PRICE_IDS=

# L2-01 server-owned membership catalog. Paid sales, paid course releases,
# metered actions, and every offer intentionally default closed. Do not use
# NEXT_PUBLIC_ for Price IDs. Set these only through an approved launch plan.
PRISMARIUM_PAID_MEMBERSHIP_SALES_ENABLED=false
PRISMARIUM_ENABLED_MEMBERSHIP_OFFERS=
PRISMARIUM_ENABLED_METERED_ACTIONS=
PRISMARIUM_MEMBER_RELEASED_COURSE_SLUGS=
PRISMARIUM_STUDENT_LAUNCH_COURSE_SLUG=
PRISMARIUM_ADEPT_LAUNCH_DECISION=hold
PRISMARIUM_STRIPE_PRICE_STUDENT_FOUNDING_MONTHLY=
PRISMARIUM_STRIPE_PRICE_STUDENT_STANDARD_MONTHLY=
PRISMARIUM_STRIPE_PRICE_SCHOLAR_MONTHLY=
PRISMARIUM_STRIPE_PRICE_ADEPT_MONTHLY=

# Course release presentation
# Keep release timing separate from publication and member enrollment progress.
# Use published course slugs; leave unset until the shared sequence is approved.
NEXT_PUBLIC_PRISMARIUM_CURRENT_COURSE_SLUG=
NEXT_PUBLIC_PRISMARIUM_NEXT_COURSE_SLUG=
NEXT_PUBLIC_PRISMARIUM_PREVIOUSLY_OPENED_COURSE_SLUGS=

# Public YouTube launch links. Keep blank until real destinations are approved.
NEXT_PUBLIC_PRISMARIUM_YOUTUBE_CHANNEL_URL=
NEXT_PUBLIC_PRISMARIUM_PRE_PLAYLIST_URL=

# Review-only FD01 graph exercise. Keep false until its learner package or
# approved static fallback is explicitly activated for the target environment.
NEXT_PUBLIC_ENABLE_FD01_GRAPH_PREVIEW=false

# Advisory guest course ballot (server-only except for the rendered public view).
# Generate a unique random secret of at least 32 characters per environment.
COURSE_PATH_POLL_SLUG=next-prismarium-youtube-series
COURSE_POLL_HASH_SECRET=
# Vercel supplies this trusted client-network header. Leave unset on other hosts
# unless the reverse proxy overwrites the configured header.
COURSE_POLL_TRUSTED_NETWORK_HEADER=x-vercel-forwarded-for
